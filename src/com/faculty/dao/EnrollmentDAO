import java.sql.*;
import java.util.Vector;

public class EnrollmentDAO {

    public Vector<Vector<Object>> getEnrollmentsByStudent(String studentName) {
        Vector<Vector<Object>> data = new Vector<>();

        String query =
                "SELECT course_code, grade, credits " +
                        "FROM enrollments WHERE student_id = " +
                        "(SELECT id FROM users WHERE username = ?)";

        try (Connection conn = dbc.getConnection()) {

            if (conn == null) return data;

            PreparedStatement ps = conn.prepareStatement(query);
            ps.setString(1, studentName);
            ResultSet rs = ps.executeQuery();

            while (rs.next()) {
                Vector<Object> row = new Vector<>();
                row.add(rs.getString("course_code"));
                row.add("Enrolled Course");
                row.add(rs.getInt("credits"));
                row.add(rs.getString("grade"));
                data.add(row);
            }
        } catch (SQLException e) {
            e.printStackTrace();
        }
        return data;
    }
}
